<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>OCTOPUS — 3D Arm Simulator</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ink: #0a0a12;
    --panel: rgba(8,8,20,0.92);
    --border: rgba(100,200,255,0.13);
    --accent: #3cf;
    --text: #b0d4e8;
    --label: #4a7a99;
    --danger: #f55;
  }
  body { background: var(--ink); font-family: 'Space Mono', monospace; color: var(--text); overflow: hidden; height: 100vh; width: 100vw; }
  #canvas-container { position: fixed; inset: 0; }
  canvas { display: block; }

  #header {
    position: fixed; top: 0; left: 0; right: 0;
    padding: 12px 20px; display: flex; align-items: center; gap: 14px;
    background: linear-gradient(to bottom, rgba(4,4,14,0.92) 0%, transparent 100%);
    pointer-events: none; z-index: 10;
  }
  #header h1 { font-size: 11px; letter-spacing: 0.3em; color: var(--accent); text-transform: uppercase; font-weight: 700; }
  #header .sub { font-size: 9px; letter-spacing: 0.18em; color: var(--label); text-transform: uppercase; }

  #toggle-panel {
    position: fixed; top: 10px; right: 14px; z-index: 20;
    background: var(--panel); border: 1px solid var(--border);
    color: var(--accent); font-family: 'Space Mono', monospace;
    font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase;
    padding: 8px 12px; border-radius: 3px; cursor: pointer;
    backdrop-filter: blur(10px);
  }

  #panel {
    position: fixed; top: 0; right: 0; bottom: 0; width: 228px;
    background: var(--panel); border-left: 1px solid var(--border);
    padding: 52px 16px 20px; z-index: 10;
    backdrop-filter: blur(14px); overflow-y: auto;
    transition: transform 0.3s ease;
    scrollbar-width: thin; scrollbar-color: var(--border) transparent;
  }
  #panel.hidden { transform: translateX(100%); }

  .panel-title {
    font-size: 8px; letter-spacing: 0.35em; color: var(--accent);
    text-transform: uppercase; margin-bottom: 12px;
    border-bottom: 1px solid var(--border); padding-bottom: 8px;
  }
  .ctrl-group { margin-bottom: 13px; }
  .ctrl-label {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 9px; letter-spacing: 0.13em; color: var(--label);
    text-transform: uppercase; margin-bottom: 6px;
  }
  .ctrl-label span { color: var(--accent); font-size: 10px; }

  input[type=range] {
    -webkit-appearance: none; appearance: none;
    width: 100%; height: 2px; background: rgba(100,200,255,0.15);
    border-radius: 2px; outline: none; cursor: pointer;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 14px; height: 14px;
    background: var(--ink); border: 2px solid var(--accent); border-radius: 50%; cursor: pointer;
  }

  /* chaos toggle */
  .toggle-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 13px;
  }
  .toggle-label { font-size: 9px; letter-spacing: 0.13em; color: var(--label); text-transform: uppercase; }
  .toggle-pill {
    position: relative; width: 38px; height: 20px; cursor: pointer;
    background: rgba(100,200,255,0.1); border: 1px solid var(--border);
    border-radius: 10px; transition: background 0.2s, border-color 0.2s;
  }
  .toggle-pill.on { background: rgba(51,204,255,0.25); border-color: var(--accent); }
  .toggle-pill::after {
    content: ''; position: absolute; top: 3px; left: 3px;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--label); transition: transform 0.2s, background 0.2s;
  }
  .toggle-pill.on::after { transform: translateX(18px); background: var(--accent); }

  /* chaos meter */
  .ctrl-group.chaos-group { opacity: 0.35; pointer-events: none; transition: opacity 0.3s; }
  .ctrl-group.chaos-group.active { opacity: 1; pointer-events: all; }

  .divider { border: none; border-top: 1px solid var(--border); margin: 12px 0; }

  /* octopus list */
  #oct-list { margin-bottom: 10px; }
  .oct-item {
    display: flex; align-items: center; gap: 6px;
    margin-bottom: 7px; padding: 7px 8px;
    background: rgba(100,200,255,0.04); border: 1px solid var(--border);
    border-radius: 3px; cursor: pointer; transition: border-color 0.15s;
  }
  .oct-item.selected { border-color: var(--accent); background: rgba(51,204,255,0.08); }
  .oct-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .oct-name { font-size: 9px; letter-spacing: 0.1em; color: var(--text); text-transform: uppercase; flex: 1; }
  .oct-del {
    font-size: 10px; color: var(--label); cursor: pointer; padding: 0 3px;
    border-radius: 2px; transition: color 0.15s;
  }
  .oct-del:hover { color: var(--danger); }

  .oct-btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 14px; }
  .oct-btn {
    background: transparent; border: 1px solid var(--border);
    color: var(--label); font-family: 'Space Mono', monospace;
    font-size: 8px; letter-spacing: 0.1em; padding: 8px 0;
    border-radius: 2px; cursor: pointer; transition: all 0.15s; text-transform: uppercase;
  }
  .oct-btn:hover { border-color: var(--accent); color: var(--accent); background: rgba(51,204,255,0.06); }
  .oct-btn.add-btn { border-color: rgba(51,204,255,0.4); color: var(--accent); }
  .oct-btn.add-btn:hover { background: rgba(51,204,255,0.12); }

  .axis-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 5px; margin-bottom: 14px; }
  .axis-btn {
    background: transparent; border: 1px solid var(--border);
    color: var(--label); font-family: 'Space Mono', monospace;
    font-size: 9px; letter-spacing: 0.08em; padding: 8px 0;
    border-radius: 2px; cursor: pointer; transition: all 0.15s; text-transform: uppercase;
  }
  .axis-btn:hover, .axis-btn.active { background: rgba(51,204,255,0.1); border-color: var(--accent); color: var(--accent); }

  .color-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 5px; }
  .color-swatch {
    height: 20px; border-radius: 2px; cursor: pointer;
    border: 2px solid transparent; transition: border-color 0.15s, transform 0.1s;
  }
  .color-swatch:hover { transform: scale(1.08); }
  .color-swatch.active { border-color: #fff; }

  #hint {
    position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%);
    font-size: 8px; letter-spacing: 0.18em; color: var(--label);
    text-transform: uppercase; pointer-events: none; opacity: 0.5; white-space: nowrap;
  }
</style>
</head>
<body>
<div id="canvas-container"></div>
<div id="header">
  <h1>OCTOPUS</h1>
  <div class="sub">3D arm field</div>
</div>
<button id="toggle-panel">Controls</button>

<div id="panel">

  <!-- OCTOPUS MANAGER -->
  <div class="panel-title">Octopi</div>
  <div id="oct-list"></div>
  <div class="oct-btn-row">
    <button class="oct-btn add-btn" id="btn-add">+ Add</button>
    <button class="oct-btn" id="btn-dup">Duplicate</button>
  </div>

  <!-- PER-OCTOPUS COLOUR -->
  <div class="panel-title">Colour</div>
  <div class="color-row" id="color-row">
    <div class="color-swatch active" data-theme="ocean"  style="background:linear-gradient(135deg,#0af,#06f)"></div>
    <div class="color-swatch"        data-theme="fire"   style="background:linear-gradient(135deg,#f80,#f03)"></div>
    <div class="color-swatch"        data-theme="bio"    style="background:linear-gradient(135deg,#0fa,#0c4)"></div>
    <div class="color-swatch"        data-theme="violet" style="background:linear-gradient(135deg,#c3f,#80f)"></div>
    <div class="color-swatch"        data-theme="gold"   style="background:linear-gradient(135deg,#ff0,#fa0)"></div>
    <div class="color-swatch"        data-theme="ice"    style="background:linear-gradient(135deg,#aef,#08f)"></div>
    <div class="color-swatch"        data-theme="coral"  style="background:linear-gradient(135deg,#f8a,#f46)"></div>
    <div class="color-swatch"        data-theme="mono"   style="background:linear-gradient(135deg,#aaa,#333)"></div>
  </div>

  <div class="divider"></div>

  <!-- SHARED PARAMS -->
  <div class="panel-title">Selected Octopus</div>

  <div class="ctrl-group">
    <div class="ctrl-label">Arms <span id="armCount-val">8</span></div>
    <input type="range" id="armCount" min="1" max="24" value="8" step="1">
  </div>
  <div class="ctrl-group">
    <div class="ctrl-label">Speed <span id="speed-val">1.0</span></div>
    <input type="range" id="speed" min="0" max="5" value="1" step="0.05">
  </div>
  <div class="ctrl-group">
    <div class="ctrl-label">Thickness <span id="thickness-val">1.0</span></div>
    <input type="range" id="thickness" min="0.05" max="8" value="1" step="0.05">
  </div>
  <div class="ctrl-group">
    <div class="ctrl-label">Opacity <span id="opacity-val">0.85</span></div>
    <input type="range" id="opacity" min="0.05" max="1" value="0.85" step="0.01">
  </div>
  <div class="ctrl-group">
    <div class="ctrl-label">Segments <span id="segments-val">18</span></div>
    <input type="range" id="segments" min="6" max="36" value="18" step="1">
  </div>
  <div class="ctrl-group">
    <div class="ctrl-label">Wave Amp <span id="amp-val">1.0</span></div>
    <input type="range" id="amp" min="0.1" max="4" value="1" step="0.05">
  </div>

  <!-- CHAOS -->
  <div class="divider"></div>
  <div class="panel-title">Chaos Mode</div>
  <div class="toggle-row">
    <div class="toggle-label">Enable chaos</div>
    <div class="toggle-pill" id="chaos-toggle"></div>
  </div>
  <div class="ctrl-group chaos-group" id="chaos-group">
    <div class="ctrl-label">Chaos <span id="chaos-val">0.5</span></div>
    <input type="range" id="chaos" min="0.01" max="1" value="0.5" step="0.01">
  </div>
  <div class="ctrl-group chaos-group" id="chaos-group2">
    <div class="ctrl-label">Tangle <span id="tangle-val">0.5</span></div>
    <input type="range" id="tangle" min="0" max="1" value="0.5" step="0.01">
  </div>

  <!-- OFFSET -->
  <div class="divider"></div>
  <div class="panel-title">Position</div>
  <div class="ctrl-group">
    <div class="ctrl-label">Offset X <span id="posX-val">0.0</span></div>
    <input type="range" id="posX" min="-10" max="10" value="0" step="0.1">
  </div>
  <div class="ctrl-group">
    <div class="ctrl-label">Offset Y <span id="posY-val">0.0</span></div>
    <input type="range" id="posY" min="-10" max="10" value="0" step="0.1">
  </div>
  <div class="ctrl-group">
    <div class="ctrl-label">Offset Z <span id="posZ-val">0.0</span></div>
    <input type="range" id="posZ" min="-10" max="10" value="0" step="0.1">
  </div>

  <!-- VIEW -->
  <div class="divider"></div>
  <div class="panel-title">View Axis</div>
  <div class="axis-row">
    <button class="axis-btn active" data-axis="free">Free</button>
    <button class="axis-btn" data-axis="top">+Y</button>
    <button class="axis-btn" data-axis="front">+Z</button>
    <button class="axis-btn" data-axis="side">+X</button>
    <button class="axis-btn" data-axis="iso">ISO</button>
    <button class="axis-btn" data-axis="under">-Y</button>
  </div>

</div>

<div id="hint">drag · pinch zoom · scroll zoom · right-drag pan</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script>
// ── SCENE ──────────────────────────────────────
const container = document.getElementById('canvas-container');
const renderer  = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setClearColor(0x0a0a12, 1);
container.appendChild(renderer.domElement);

const scene  = new THREE.Scene();
scene.fog    = new THREE.FogExp2(0x0a0a12, 0.018);
const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.01, 400);
camera.position.set(0, 4, 22);

scene.add(new THREE.AmbientLight(0xffffff, 0.3));
const pA = new THREE.PointLight(0x33ccff, 3, 120); pA.position.set(10,15,10);  scene.add(pA);
const pB = new THREE.PointLight(0xcc66ff, 2, 90);  pB.position.set(-12,-8,-5); scene.add(pB);
const pC = new THREE.PointLight(0xffffff, 1, 60);  pC.position.set(0,20,0);    scene.add(pC);

// ── ORBIT ──────────────────────────────────────
const orb = { theta:0.3, phi:1.1, radius:22, tT:0.3, tP:1.1, tR:22,
               panX:0, panY:0, tPX:0, tPY:0, drag:false, pan:false, lx:0, ly:0 };
const cvs = renderer.domElement;

cvs.addEventListener('mousedown', e => {
  if(e.button===0) orb.drag=true;
  if(e.button===2) orb.pan=true;
  orb.lx=e.clientX; orb.ly=e.clientY;
});
window.addEventListener('mouseup',   () => { orb.drag=false; orb.pan=false; });
window.addEventListener('mousemove', e => {
  const dx=e.clientX-orb.lx, dy=e.clientY-orb.ly;
  if(orb.drag){ orb.tT-=dx*0.005; orb.tP=Math.max(0.05,Math.min(Math.PI-0.05,orb.tP+dy*0.005)); }
  if(orb.pan) { orb.tPX-=dx*0.025; orb.tPY+=dy*0.025; }
  orb.lx=e.clientX; orb.ly=e.clientY;
});
cvs.addEventListener('wheel', e=>{ orb.tR=Math.max(3,Math.min(80,orb.tR+e.deltaY*0.025)); });
cvs.addEventListener('contextmenu', e=>e.preventDefault());

let pinchDist=0;
cvs.addEventListener('touchstart', e=>{
  if(e.touches.length===1){ orb.drag=true; orb.lx=e.touches[0].clientX; orb.ly=e.touches[0].clientY; }
  if(e.touches.length===2){ orb.drag=false; pinchDist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY); }
},{ passive:true });
cvs.addEventListener('touchend', ()=>{ orb.drag=false; },{ passive:true });
cvs.addEventListener('touchmove', e=>{
  if(e.touches.length===1 && orb.drag){
    const dx=e.touches[0].clientX-orb.lx, dy=e.touches[0].clientY-orb.ly;
    orb.tT-=dx*0.005; orb.tP=Math.max(0.05,Math.min(Math.PI-0.05,orb.tP+dy*0.005));
    orb.lx=e.touches[0].clientX; orb.ly=e.touches[0].clientY;
  }
  if(e.touches.length===2){
    const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
    orb.tR=Math.max(3,Math.min(80,orb.tR-(d-pinchDist)*0.04));
    pinchDist=d;
  }
  e.preventDefault();
},{ passive:false });

function updateCamera(){
  const L=0.07;
  orb.theta  +=(orb.tT  -orb.theta) *L;
  orb.phi    +=(orb.tP  -orb.phi)   *L;
  orb.radius +=(orb.tR  -orb.radius)*L;
  orb.panX   +=(orb.tPX -orb.panX)  *L;
  orb.panY   +=(orb.tPY -orb.panY)  *L;
  camera.position.set(
    orb.radius*Math.sin(orb.phi)*Math.sin(orb.theta)+orb.panX,
    orb.radius*Math.cos(orb.phi)+orb.panY,
    orb.radius*Math.sin(orb.phi)*Math.cos(orb.theta)
  );
  camera.lookAt(orb.panX, orb.panY, 0);
}

// ── THEMES ─────────────────────────────────────
const THEMES = {
  ocean:  [new THREE.Color(0x002288), new THREE.Color(0x0055ff), new THREE.Color(0x00aaff)],
  fire:   [new THREE.Color(0x990000), new THREE.Color(0xff2200), new THREE.Color(0xff8800)],
  bio:    [new THREE.Color(0x004422), new THREE.Color(0x00cc44), new THREE.Color(0x00ffaa)],
  violet: [new THREE.Color(0x440088), new THREE.Color(0x8800ff), new THREE.Color(0xcc33ff)],
  gold:   [new THREE.Color(0x443300), new THREE.Color(0xcc7700), new THREE.Color(0xffee00)],
  ice:    [new THREE.Color(0x003355), new THREE.Color(0x0088cc), new THREE.Color(0xaaeeff)],
  coral:  [new THREE.Color(0x440022), new THREE.Color(0xcc4466), new THREE.Color(0xff88aa)],
  mono:   [new THREE.Color(0x111111), new THREE.Color(0x555555), new THREE.Color(0xaaaaaa)],
};
const THEME_DOTS = {
  ocean:'#0af', fire:'#f83', bio:'#0fa', violet:'#c3f',
  gold:'#ff0',  ice:'#aef',  coral:'#f8a', mono:'#888',
};

// ── NOISE helpers for chaos ─────────────────────
// Simple value noise — avoids any external dependency
function hash(n){ let x=Math.sin(n)*43758.5453; return x-Math.floor(x); }
function noise1(x, seed=0){
  const i=Math.floor(x); const f=x-i;
  const u=f*f*(3-2*f);
  return hash(i+seed)*( 1-u) + hash(i+1+seed)*u;
}
function fbm(x, oct, seed=0){
  let v=0, a=0.5, freq=1;
  for(let i=0;i<oct;i++){ v+=a*noise1(x*freq,seed+i*31); a*=0.5; freq*=2; }
  return v;
}

// ── OCTOPUS DATA ───────────────────────────────
let octopi   = [];   // array of config objects
let selected = 0;    // index of selected octopus
let uidCounter = 0;

const RAD = 9; // radial ring segments

function defaultOctopus(index) {
  const themes = Object.keys(THEMES);
  return {
    uid: uidCounter++,
    name: `OCT-${String(index+1).padStart(2,'0')}`,
    theme: themes[index % themes.length],
    armCount: 8,
    speed: 1.0,
    thickness: 1.0,
    opacity: 0.85,
    segments: 18,
    amp: 1.0,
    chaos: false,
    chaosAmt: 0.5,
    tangle: 0.5,
    posX: 0, posY: 0, posZ: 0,
    // runtime
    group: null,
    arms: [],
    noiseSeeds: [],
  };
}

// ── BUILD ARM MESHES for one octopus ───────────
function disposeOctopus(oct) {
  if (!oct.group) return;
  while (oct.group.children.length) {
    const m = oct.group.children[0];
    m.geometry.dispose(); m.material.dispose();
    oct.group.remove(m);
  }
  scene.remove(oct.group);
  oct.group = null;
  oct.arms  = [];
}

function buildOctopus(oct) {
  disposeOctopus(oct);
  oct.group = new THREE.Group();
  oct.group.position.set(oct.posX, oct.posY, oct.posZ);
  scene.add(oct.group);
  oct.arms = [];
  // pre-generate noise seeds per arm
  oct.noiseSeeds = Array.from({length: oct.armCount}, (_,i) => i * 137 + oct.uid * 53);

  const vCount = (oct.segments+1)*(RAD+1);
  for (let i = 0; i < oct.armCount; i++) {
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(vCount*3), 3));
    geo.setAttribute('color',    new THREE.BufferAttribute(gradientColors(oct), 3));
    geo.setIndex(buildIndices(oct.segments));

    const mat = new THREE.MeshPhongMaterial({
      vertexColors: true, transparent: true, opacity: oct.opacity,
      shininess: 90, side: THREE.DoubleSide,
      emissive: THEMES[oct.theme][0], emissiveIntensity: 0.5,
    });
    const mesh = new THREE.Mesh(geo, mat);
    oct.group.add(mesh);
    oct.arms.push({ mesh, index: i });
  }
}

function gradientColors(oct) {
  const [cBase, cMid, cTip] = THEMES[oct.theme];
  const total = (oct.segments+1)*(RAD+1);
  const buf   = new Float32Array(total*3);
  const col   = new THREE.Color();
  for (let i = 0; i <= oct.segments; i++) {
    const frac = i / oct.segments;
    if (frac < 0.5) col.lerpColors(cBase, cMid, frac*2);
    else            col.lerpColors(cMid, cTip, (frac-0.5)*2);
    for (let j = 0; j <= RAD; j++) {
      const off = (i*(RAD+1)+j)*3;
      buf[off]=col.r; buf[off+1]=col.g; buf[off+2]=col.b;
    }
  }
  return buf;
}

function buildIndices(segs) {
  const idx = [];
  for (let i = 0; i < segs; i++) {
    for (let j = 0; j < RAD; j++) {
      const a=i*(RAD+1)+j, b=(i+1)*(RAD+1)+j;
      idx.push(a,b,a+1, b,b+1,a+1);
    }
  }
  return idx;
}

// ── SPINE COMPUTATION ──────────────────────────
function computeSpine(oct, armIdx, t) {
  const seg    = oct.segments;
  const len    = 7;
  const count  = oct.armCount;
  const angle  = (armIdx / count) * Math.PI * 2;
  const phOff  = armIdx * (Math.PI*2 / count);
  const seed   = oct.noiseSeeds[armIdx] || armIdx*137;
  const pts    = [];

  for (let j = 0; j <= seg; j++) {
    const frac = j / seg;
    const r    = frac * len;
    const f    = 2.5;

    // base wave
    let wX = Math.sin(frac*Math.PI*f       + t       + phOff) * frac * 1.4 * oct.amp;
    let wY = Math.cos(frac*Math.PI*f*0.7   + t*1.3   + phOff) * frac * 0.8 * oct.amp;
    let wZ = Math.sin(frac*Math.PI*f*1.3   + t*0.6   + phOff+1) * frac * 0.6 * oct.amp;

    if (oct.chaos) {
      const c     = oct.chaosAmt;
      const tn    = oct.tangle;
      const tScale = 0.7 + tn * 2.5;  // tangle spreads arms more
      const tFreq  = 1.5 + c * 4;     // chaos adds high-freq jitter

      // FBM-based random writhing — each arm has unique seeds
      const nx = fbm(frac*tFreq + t*0.8  + seed,    4, seed);
      const ny = fbm(frac*tFreq + t*0.6  + seed+11, 4, seed+11);
      const nz = fbm(frac*tFreq + t*1.1  + seed+23, 4, seed+23);

      // also add a slow tangling drift that crosses arms into a knot
      const knotX = Math.sin(t*0.3 + phOff*tn + frac*Math.PI*tn*3) * tn * 2 * frac;
      const knotY = Math.cos(t*0.4 + phOff*tn + frac*Math.PI*tn*2) * tn * 1.5 * frac;

      wX += (nx-0.5)*2 * c * tScale * frac + knotX;
      wY += (ny-0.5)*2 * c * tScale * frac * 0.6 + knotY;
      wZ += (nz-0.5)*2 * c * tScale * frac;
    }

    const bx = Math.cos(angle)*r;
    const bz = Math.sin(angle)*r;
    pts.push({
      x: bx + Math.cos(angle)*wX - Math.sin(angle)*wY,
      y: wZ,
      z: bz + Math.sin(angle)*wX + Math.cos(angle)*wY
    });
  }
  return pts;
}

// ── FILL TUBE POSITIONS ─────────────────────────
const _up=new THREE.Vector3(0,1,0);
const _t =new THREE.Vector3();
const _n =new THREE.Vector3();
const _b =new THREE.Vector3();

function fillPositions(posAttr, pts, thickness) {
  const seg = pts.length-1;
  const rad = 0.18 * thickness;
  for (let i = 0; i <= seg; i++) {
    const frac  = i / seg;
    const taper = 1 - frac*0.88;
    const r     = rad*taper;
    const next  = i < seg ? i+1 : i-1;
    const sign  = i < seg ? 1   : -1;
    _t.set((pts[next].x-pts[i].x)*sign,(pts[next].y-pts[i].y)*sign,(pts[next].z-pts[i].z)*sign).normalize();
    const dot=_t.dot(_up);
    _n.set(_up.x-dot*_t.x,_up.y-dot*_t.y,_up.z-dot*_t.z);
    if(_n.lengthSq()<1e-6) _n.set(1,0,0);
    _n.normalize();
    _b.crossVectors(_t,_n).normalize();
    const px=pts[i].x,py=pts[i].y,pz=pts[i].z;
    for (let j=0;j<=RAD;j++){
      const a=(j/RAD)*Math.PI*2;
      const cos=Math.cos(a),sin=Math.sin(a);
      const idx=i*(RAD+1)+j;
      posAttr.setXYZ(idx,
        px+(_n.x*cos+_b.x*sin)*r,
        py+(_n.y*cos+_b.y*sin)*r,
        pz+(_n.z*cos+_b.z*sin)*r
      );
    }
  }
  posAttr.needsUpdate=true;
}

// ── PARTICLES ──────────────────────────────────
const pGeo=new THREE.BufferGeometry();
const pPos=new Float32Array(600*3);
for(let i=0;i<600;i++){
  pPos[i*3]=(Math.random()-0.5)*100; pPos[i*3+1]=(Math.random()-0.5)*80; pPos[i*3+2]=(Math.random()-0.5)*100;
}
pGeo.setAttribute('position',new THREE.BufferAttribute(pPos,3));
const particles=new THREE.Points(pGeo,new THREE.PointsMaterial({color:0x224466,size:0.07,transparent:true,opacity:0.35}));
scene.add(particles);

// ── UI HELPERS ─────────────────────────────────
function getSelected(){ return octopi[selected]; }

function refreshOctList() {
  const list = document.getElementById('oct-list');
  list.innerHTML = '';
  octopi.forEach((oct, i) => {
    const div = document.createElement('div');
    div.className = 'oct-item' + (i===selected?' selected':'');
    div.innerHTML = `
      <div class="oct-dot" style="background:${THEME_DOTS[oct.theme]}"></div>
      <div class="oct-name">${oct.name}</div>
      <div class="oct-del" data-i="${i}">✕</div>`;
    div.addEventListener('click', e => {
      if(e.target.classList.contains('oct-del')) return;
      selected = i;
      refreshOctList();
      loadOctopusToPanel(octopi[i]);
    });
    div.querySelector('.oct-del').addEventListener('click', () => {
      if(octopi.length <= 1) return; // keep at least one
      disposeOctopus(octopi[i]);
      octopi.splice(i, 1);
      selected = Math.min(selected, octopi.length-1);
      refreshOctList();
      loadOctopusToPanel(octopi[selected]);
    });
    list.appendChild(div);
  });
}

function loadOctopusToPanel(oct) {
  setSlider('armCount', oct.armCount, 0);
  setSlider('speed',    oct.speed,    1);
  setSlider('thickness',oct.thickness,1);
  setSlider('opacity',  oct.opacity,  2);
  setSlider('segments', oct.segments, 0);
  setSlider('amp',      oct.amp,      1);
  setSlider('chaos',    oct.chaosAmt, 2);
  setSlider('tangle',   oct.tangle,   2);
  setSlider('posX',     oct.posX,     1);
  setSlider('posY',     oct.posY,     1);
  setSlider('posZ',     oct.posZ,     1);
  // chaos toggle
  const pill = document.getElementById('chaos-toggle');
  pill.classList.toggle('on', oct.chaos);
  document.getElementById('chaos-group').classList.toggle('active', oct.chaos);
  document.getElementById('chaos-group2').classList.toggle('active', oct.chaos);
  // colour swatches
  document.querySelectorAll('.color-swatch').forEach(sw => {
    sw.classList.toggle('active', sw.dataset.theme === oct.theme);
  });
}

function setSlider(id, val, dec) {
  const inp = document.getElementById(id);
  const lbl = document.getElementById(id+'-val');
  if(inp){ inp.value = val; lbl.textContent = parseFloat(val).toFixed(dec); }
}

// ── WIRE CONTROLS ──────────────────────────────
function wire(id, key, dec, rebuild) {
  const inp = document.getElementById(id);
  const lbl = document.getElementById(id+'-val');
  inp.addEventListener('input', () => {
    const oct = getSelected();
    if(!oct) return;
    oct[key] = parseFloat(inp.value);
    lbl.textContent = oct[key].toFixed(dec);
    if(rebuild){
      buildOctopus(oct);
    } else {
      // live-update material only
      oct.arms.forEach(a => { a.mesh.material.opacity = oct.opacity; });
    }
  });
}

wire('armCount', 'armCount', 0, true);
wire('speed',    'speed',    1, false);
wire('thickness','thickness',1, false);
wire('opacity',  'opacity',  2, false);
wire('segments', 'segments', 0, true);
wire('amp',      'amp',      1, false);
wire('chaos',    'chaosAmt', 2, false);
wire('tangle',   'tangle',   2, false);

// position sliders
['posX','posY','posZ'].forEach(id => {
  const inp = document.getElementById(id);
  const lbl = document.getElementById(id+'-val');
  inp.addEventListener('input', () => {
    const oct = getSelected(); if(!oct) return;
    oct[id.toLowerCase()] = parseFloat(inp.value);
    lbl.textContent = parseFloat(inp.value).toFixed(1);
    if(oct.group) oct.group.position.set(oct.posX, oct.posY, oct.posZ);
  });
});

// chaos toggle
document.getElementById('chaos-toggle').addEventListener('click', () => {
  const oct = getSelected(); if(!oct) return;
  oct.chaos = !oct.chaos;
  document.getElementById('chaos-toggle').classList.toggle('on', oct.chaos);
  document.getElementById('chaos-group').classList.toggle('active', oct.chaos);
  document.getElementById('chaos-group2').classList.toggle('active', oct.chaos);
});

// colour swatches
document.querySelectorAll('.color-swatch').forEach(sw => {
  sw.addEventListener('click', () => {
    const oct = getSelected(); if(!oct) return;
    oct.theme = sw.dataset.theme;
    document.querySelectorAll('.color-swatch').forEach(s=>s.classList.remove('active'));
    sw.classList.add('active');
    buildOctopus(oct);
    refreshOctList();
  });
});

// add / duplicate
document.getElementById('btn-add').addEventListener('click', () => {
  const oct = defaultOctopus(octopi.length);
  oct.posX  = (Math.random()-0.5)*6;
  oct.posZ  = (Math.random()-0.5)*6;
  octopi.push(oct);
  buildOctopus(oct);
  selected = octopi.length-1;
  refreshOctList();
  loadOctopusToPanel(oct);
});

document.getElementById('btn-dup').addEventListener('click', () => {
  const src = getSelected(); if(!src) return;
  const oct = JSON.parse(JSON.stringify(src)); // deep clone config
  oct.uid   = uidCounter++;
  oct.name  = `OCT-${String(octopi.length+1).padStart(2,'0')}`;
  oct.posX  += 3 + Math.random()*2;
  oct.group  = null; oct.arms = []; oct.noiseSeeds = [];
  octopi.push(oct);
  buildOctopus(oct);
  selected = octopi.length-1;
  refreshOctList();
  loadOctopusToPanel(oct);
});

// axis
document.querySelectorAll('.axis-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.axis-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    orb.tPX=0; orb.tPY=0;
    switch(btn.dataset.axis){
      case 'top':   orb.tP=0.05;          orb.tT=0;         break;
      case 'under': orb.tP=Math.PI-0.05;  orb.tT=0;         break;
      case 'front': orb.tP=Math.PI/2;     orb.tT=0;         break;
      case 'side':  orb.tP=Math.PI/2;     orb.tT=Math.PI/2; break;
      case 'iso':   orb.tP=1.05;          orb.tT=0.75;      break;
    }
  });
});

document.getElementById('toggle-panel').addEventListener('click', () => {
  document.getElementById('panel').classList.toggle('hidden');
});

// ── INIT ───────────────────────────────────────
const firstOct = defaultOctopus(0);
octopi.push(firstOct);
buildOctopus(firstOct);
refreshOctList();
loadOctopusToPanel(firstOct);

// ── ANIMATE ────────────────────────────────────
let clock = 0;
(function animate() {
  requestAnimationFrame(animate);
  clock += 0.008;

  octopi.forEach(oct => {
    if(!oct.group) return;
    const t = clock * oct.speed;
    oct.arms.forEach(arm => {
      const pts = computeSpine(oct, arm.index, t);
      fillPositions(arm.mesh.geometry.attributes.position, pts, oct.thickness);
      arm.mesh.geometry.computeVertexNormals();
    });
  });

  particles.rotation.y += 0.0002;
  updateCamera();
  renderer.render(scene, camera);
})();

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});
</script>
